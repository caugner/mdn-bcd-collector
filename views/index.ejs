<%- contentFor('body') %>
<h1 id="title">BCD collector <% if (dev) { %> (dev)<% } %></h1>
<div id="subtitle">
  <p>Browser compatibility data collection for <a href="https://github.com/mdn/browser-compat-data">@mdn/browser-compat-data</a>. <p>

  <p> <a href="https://openwebdocs.org/"><img src="/owd-logo-light.png" alt="Open Web Docs logo"></a></p>

  <p>The BCD collector is maintained by Open Web Docs. <br> You can support this project via
  <a href="https://opencollective.com/open-web-docs">sponsorships</a> on Open Source Collective.</p>
</div>

<%- include('extensioncheck') %>

<div id="run-tests" class="paper">
  <h2>Run Tests</h2>
  <form id="test-form" action="/api/get" method="post">
    <div id="test-entry">
      <div id="test-combobox">
        <input id="test-selection" name="testSelection" type="text" role="combobox" aria-label="Test selection" aria-autocomplete="list" aria-controls="test-options" aria-expanded="false" aria-haspopup="listbox" autocomplete="off" placeholder="All Tests">
        <ul id="test-options" role="listbox"></ul>
      </div>
      <div id="test-results-status" role="status" aria-live="polite"></div>
      <button name="submit" type="submit" id="start"><span class="mdi mdi-play"></span> Run</button>
    </div>
    <br>
    <div id="limit-exposure-box">
      <label for="limit-exposure"><span class="mdi mdi-circle-multiple-outline"></span> Limit Exposure:</label>
      <select id="limit-exposure" name="limitExposure">
        <option value="">All global exposures</option>
        <option value="Window">Window</option>
        <option value="Worker">Dedicated Worker</option>
        <option value="SharedWorker">Shared Worker</option>
        <option value="ServiceWorker">Service Worker</option>
      </select>
    </div>
    <br>
    <div id="preview-box">
      <label for="preview"><span class="mdi mdi-flask"></span> Collect as preview browser:</label>
      <input type="checkbox" id="preview" name="preview">
    </div>
    <% if (selenium) { %>
      <input id="selenium" name="selenium" type="hidden" value="true">
      <input id="ignore" name="ignore" type="hidden" value="<%=ignore%>">
    <% } %>
  </form>
  <%- include('unsecurewarning') %>
  <%- include('browserinfo') %>
</div>

<div id="supported-browsers">
  <h2>Supported browsers</h2>
  <p>Various browsers and environments are supported:</p>
  <p>Chrome 1+ / Edge 12+ / Firefox 1+ / Opera 9.5+ / Safari 3+</p>
  <p>Samsung Browser / Android & iOS WebViews / Oculus / and more</p>
  <p>Nodejs (see also the <a href="https://github.com/unjs/runtime-compat">RCD</a> project)</p>
</div> 

<div id="known-caveats" class="paper">
  <h2><span class="mdi mdi-glass-fragile"></span>Double check results</h2>
  <p>Some browser extensions, such as password managers, may cause compatibility conflicts. Disable extensions if possible.</p>
  <p id="known-caveats-file-issue">If you find any errors in feature detection, please <a href="https://github.com/openwebdocs/mdn-bcd-collector/issues/new"><span class="mdi mdi-alert-circle-outline"></span> file an issue</a> in the GitHub repository.</p>
</div>

<div id="privacy-notice" class="paper">
  <h2><span class="mdi mdi-hand-back-left"></span> Privacy notice</h2>
  <p>This website is designed to test as many browser features as possible. This includes features that access sensitive information, such as microphone, camera, geolocation, etc. <strong>No audio/video, geocoordinates, browser history, or other personal info is recorded, stored or transmitted.</strong> Only two pieces of information that identify your browser configuration are recorded: your browser's user agent string, which includes data about your operating system and browser version; and installed extensions from a set list of extensions known to cause compatibility testing issues.</p>
  <p>Cookies are used for session tracking, so that test results can be stored on the server and then optionally exported. Cached test results are cleared regularly.</p>
</div>

<script>
  function main() {
    var testSelection = document.getElementById('test-selection');
    var testCombobox = document.getElementById('test-combobox');
    var testOptions = document.getElementById('test-options');
    var testResultsStatus = document.getElementById('test-results-status');
    var limitExposureBox = document.getElementById('limit-exposure-box');
    var tests = <%- JSON.stringify(tests).replace(/</g, "\\u003c") %>;
    var maxVisibleTests = 100;
    var activeIndex = -1;
    var expanded = false;
    var matchingTests = [];
    var filteredTests = [];
    var renderedOptions = [];

    function addEvent(element, type, handler) {
      if (element.addEventListener) {
        element.addEventListener(type, handler, false);
      } else if (element.attachEvent) {
        element.attachEvent('on' + type, function() {
          handler(window.event);
        });
      }
    }

    function clearChildren(element) {
      while (element.firstChild) {
        element.removeChild(element.firstChild);
      }
    }

    function setText(element, text) {
      if ('textContent' in element) {
        element.textContent = text;
      } else {
        element.innerText = text;
      }
    }

    function preventDefault(event) {
      if (event.preventDefault) {
        event.preventDefault();
      } else {
        event.returnValue = false;
      }
    }

    function contains(parent, child) {
      while (child) {
        if (child == parent) {
          return true;
        }
        child = child.parentNode;
      }
      return false;
    }

    function updateLimitExposure() {
      if (testSelection.value == '' || testSelection.value.indexOf('api') == 0) {
        limitExposureBox.style.display = "block";
      } else {
        limitExposureBox.style.display = "none";
      }
    }

    function setExpanded(isExpanded) {
      expanded = !!isExpanded;
      testSelection.setAttribute('aria-expanded', expanded ? 'true' : 'false');
      testOptions.style.display = expanded ? "block" : "none";
      if (!expanded) {
        activeIndex = -1;
        testSelection.removeAttribute('aria-activedescendant');
      }
    }

    function renderOptions() {
      var query = testSelection.value.toLowerCase();
      matchingTests = [];
      filteredTests = [];
      if (query) {
        for (var testIndex = 0; testIndex < tests.length; testIndex++) {
          if (tests[testIndex].toLowerCase().indexOf(query) != -1) {
            matchingTests.push(tests[testIndex]);
            if (filteredTests.length < maxVisibleTests) {
              filteredTests.push(tests[testIndex]);
            }
          }
        }
      }
      clearChildren(testOptions);
      renderedOptions = [];
      for (var index = 0; index < filteredTests.length; index++) {
        var test = filteredTests[index];
        var option = document.createElement('li');
        option.id = 'test-option-' + index;
        option.setAttribute('role', 'option');
        option.setAttribute('aria-selected', index == activeIndex ? 'true' : 'false');
        setText(option, test);
        addEvent(option, 'mousedown', function(event) {
          preventDefault(event);
        });
        (function(optionIndex) {
          addEvent(option, 'click', function() {
            selectTest(optionIndex);
          });
        })(index);
        testOptions.appendChild(option);
        renderedOptions.push(option);
      }
      if (!query) {
        setText(testResultsStatus, 'Type to filter tests');
      } else if (!matchingTests.length) {
        setText(testResultsStatus, 'No matching tests');
      } else if (matchingTests.length > maxVisibleTests) {
        setText(testResultsStatus, 'Showing first ' + maxVisibleTests + ' of ' + matchingTests.length + ' matching tests');
      } else {
        setText(testResultsStatus, matchingTests.length + ' matching test' + (matchingTests.length == 1 ? '' : 's'));
      }
      if (activeIndex >= filteredTests.length) {
        activeIndex = -1;
        testSelection.removeAttribute('aria-activedescendant');
      }
    }

    function openOptions() {
      renderOptions();
      setExpanded(true);
    }

    function getKey(event) {
      var key = event.key;
      var keyIdentifier = event.keyIdentifier;
      if (key == 'ArrowDown' || key == 'Down' || keyIdentifier == 'ArrowDown' || keyIdentifier == 'Down' || event.keyCode == 40) {
        return 'ArrowDown';
      }
      if (key == 'ArrowUp' || key == 'Up' || keyIdentifier == 'ArrowUp' || keyIdentifier == 'Up' || event.keyCode == 38) {
        return 'ArrowUp';
      }
      if (key == 'Enter' || keyIdentifier == 'Enter' || keyIdentifier == 'U+000D' || event.keyCode == 13) {
        return 'Enter';
      }
      if (key == 'Escape' || key == 'Esc' || key == 'U+001B' || keyIdentifier == 'Escape' || keyIdentifier == 'Esc' || keyIdentifier == 'U+001B' || event.keyCode == 27) {
        return 'Escape';
      }
      return '';
    }

    function selectTest(index) {
      if (index < 0 || index >= filteredTests.length) {
        return;
      }
      testSelection.value = filteredTests[index];
      updateLimitExposure();
      setExpanded(false);
    }

    function setActive(index) {
      if (!filteredTests.length) {
        return;
      }
      activeIndex = Math.max(0, Math.min(index, filteredTests.length - 1));
      var options = renderedOptions;
      for (var optionIndex = 0; optionIndex < options.length; optionIndex++) {
        options[optionIndex].setAttribute('aria-selected', optionIndex == activeIndex ? 'true' : 'false');
      }
      var activeOption = options[activeIndex];
      testSelection.setAttribute('aria-activedescendant', activeOption.id);
      if (activeOption.scrollIntoView) {
        activeOption.scrollIntoView(false);
      }
    }

    addEvent(testSelection, 'focus', openOptions);
    addEvent(testSelection, 'click', function() {
      if (!expanded) {
        openOptions();
      }
    });
    addEvent(testSelection, 'blur', function() {
      setExpanded(false);
    });
    function handleInput() {
      activeIndex = -1;
      testSelection.removeAttribute('aria-activedescendant');
      updateLimitExposure();
      openOptions();
    }
    if ('oninput' in testSelection) {
      addEvent(testSelection, 'input', handleInput);
    } else if ('onpropertychange' in testSelection) {
      addEvent(testSelection, 'propertychange', function(event) {
        if (!event.propertyName || event.propertyName == 'value') {
          handleInput();
        }
      });
    } else {
      addEvent(testSelection, 'keyup', handleInput);
    }
    addEvent(testSelection, 'change', updateLimitExposure);
    addEvent(testSelection, 'keydown', function(event) {
      var key = getKey(event);
      if (key == 'ArrowDown') {
        preventDefault(event);
        if (!expanded) {
          openOptions();
        }
        setActive(activeIndex + 1);
      } else if (key == 'ArrowUp') {
        preventDefault(event);
        if (!expanded) {
          openOptions();
        }
        setActive(activeIndex < 0 ? filteredTests.length - 1 : activeIndex - 1);
      } else if (key == 'Enter' && expanded && activeIndex >= 0) {
        preventDefault(event);
        selectTest(activeIndex);
      } else if (key == 'Escape' && expanded) {
        preventDefault(event);
        setExpanded(false);
      }
    });
    addEvent(document, 'mousedown', function(event) {
      if (!contains(testCombobox, event.target || event.srcElement)) {
        setExpanded(false);
      }
    });
    updateLimitExposure();
  }

  window.onload = main;
</script>
